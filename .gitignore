# Dependencies (reinstalled per machine with `npm install`)
node_modules/

# Build output (regenerated with `npm run dist`)
dist/
out/

# Generated packaging icons (.ico/.icns) — rebuilt from icons/ by `npm run icons`
# (icons/ is the source of truth, so these derived files are not tracked)
build/

# Logs & debug
*.log
npm-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.local

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

.agent/

# Personal design notes, not for publication
context.md
